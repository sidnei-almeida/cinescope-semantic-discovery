# The semantic recommender runs as a Vercel Python function in this same project
# (api/index.py), so the browser calls /api/v1/recommend on the same origin and
# no configuration is needed.
#
# Set this only to point a local dev build at a remote deployment instead of the
# local `npm run api` server.
# VITE_RECOMMENDER_API_URL=https://your-deployment.vercel.app

VITE_TMDB_API_KEY=
VITE_TMDB_READ_TOKEN=
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
